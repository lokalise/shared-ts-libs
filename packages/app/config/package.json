{
  "name": "@lokalise/config",
  "version": "1.0.1",
  "type": "module",
  "description": "Shared envase config schemas for Lokalise services",
  "license": "Apache-2.0",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/lokalise/shared-ts-libs",
  "repository": {
    "type": "git",
    "url": "git://github.com/lokalise/shared-ts-libs.git",
    "directory": "packages/app/config"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf dist && tsc --project tsconfig.build.json",
    "clean": "rimraf dist",
    "lint": "biome check . && tsc",
    "lint:fix": "biome check --write",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "envase": ">=2.0.0",
    "zod": ">=4.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@lokalise/biome-config": "workspace:^",
    "@lokalise/tsconfig": "workspace:^",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "envase": "^2.1.0",
    "ioredis": "^6.0.0",
    "rimraf": "^6.1.3",
    "typescript": "7.0.2",
    "vitest": "^5.0.5",
    "zod": "^4.3.6"
  }
}
