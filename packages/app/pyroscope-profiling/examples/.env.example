# Continuous profiling with Grafana Pyroscope.
#
# Everything below is optional and profiling is off until PYROSCOPE_ENABLED is
# true, so a service that copies this file unchanged behaves exactly as it did
# before. It stays off under NODE_ENV=test whatever the switch says, so this
# file is safe to share with a test runner.
#
# For the local loop (a load test on this machine, read with
# `pyroscope-analyze`), the four lines that matter are PYROSCOPE_ENABLED,
# PYROSCOPE_SERVER_ADDRESS and the two sampling variables at the bottom that
# make a run shorter than an hour produce more than one data point. Bring up
# somewhere to ship to with
# `docker compose -f docker-compose.pyroscope.yml up -d`.

# ---- read by @lokalise/pyroscope-profiling ----

PYROSCOPE_ENABLED=false
PYROSCOPE_SERVER_ADDRESS=http://localhost:4040
# Name the profiles are filed under. Falls back to the appName passed in code,
# which is normally the service name, so leaving this empty is the usual case.
PYROSCOPE_APPLICATION_NAME=
# Bearer token for the ingest endpoint. Takes precedence over basic auth.
PYROSCOPE_AUTH_TOKEN=
# Grafana Cloud Profiles wants basic auth instead: the user is the numeric stack
# id, the password an access token with the `profiles:write` scope.
PYROSCOPE_BASIC_AUTH_USER=
PYROSCOPE_BASIC_AUTH_PASSWORD=
# X-Scope-OrgID, for a multi-tenant Pyroscope.
PYROSCOPE_TENANT_ID=
# Label the profiler's samples with the span they were taken under, which is
# what links a trace in Grafana to the profile taken while it was open:
#
#   pyroscope-analyze --service my-service --select 'span_name="POST /v1/checkout"'
#
# Needs OTEL_ENABLED and PYROSCOPE_ENABLED as well: a label needs a span to come
# from and a profiler to land on. The route in that query comes from the Fastify
# plugin, which knows it while the request is still being served; a span carries
# only the method until its response has gone out.
PYROSCOPE_SPAN_PROFILES_ENABLED=false

# ---- read by the Pyroscope SDK itself ----
#
# Sampling rates are the SDK's own, passed through untouched, because anything
# this package passed to init() would silently outrank whatever was set here.
# The defaults are what the commented values below repeat.
#
# The first two are worth lowering for a local run: at the 60-second default a
# three-minute load test produces three data points, and the last window only
# arrives when the process stops.

# PYROSCOPE_FLUSH_INTERVAL_MS=60000
# PYROSCOPE_WALL_SAMPLING_DURATION_MS=60000
# 10000 micros is 100 Hz.
# PYROSCOPE_WALL_SAMPLING_INTERVAL_MICROS=10000
# Records CPU time alongside wall time, which is what separates "we are busy"
# from "we are waiting" in a single flame graph.
# PYROSCOPE_WALL_COLLECT_CPU_TIME=false
# PYROSCOPE_HEAP_SAMPLING_INTERVAL_BYTES=524288
# PYROSCOPE_HEAP_STACK_DEPTH=64
# `all` or `dependencies`: drops file names from the frames, for a profile that
# must not carry source paths.
# PYROSCOPE_STRIP_FILENAMES=
# PYROSCOPE_SHORTEN_PATHS=false

# ---- labels, from what the deployment already sets ----
#
# Every profile carries these, so a flame graph can be narrowed to one
# environment, release or pod.

APP_ENV=development
APP_VERSION=
GIT_COMMIT_SHA=
