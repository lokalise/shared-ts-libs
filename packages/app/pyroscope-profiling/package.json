{
    "name": "@lokalise/pyroscope-profiling",
    "version": "1.1.1",
    "bin": {
        "pyroscope-analyze": "./bin/analyze.mjs"
    },
    "type": "module",
    "license": "Apache-2.0",
    "files": [
        "dist/**",
        "bin/analyze.mjs",
        "bin/analyzeCommand.mjs",
        "examples/**",
        "LICENSE.md",
        "README.md"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": "./dist/index.js",
        "./opentelemetry": "./dist/opentelemetry.js",
        "./fastify": "./dist/fastify.js",
        "./package.json": "./package.json"
    },
    "keywords": [
        "pyroscope",
        "profiling",
        "continuous-profiling",
        "flamegraph",
        "grafana",
        "fastify",
        "opentelemetry"
    ],
    "homepage": "https://github.com/lokalise/shared-ts-libs",
    "repository": {
        "type": "git",
        "url": "git://github.com/lokalise/shared-ts-libs.git",
        "directory": "packages/app/pyroscope-profiling"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "rimraf dist && tsc --project tsconfig.build.json",
        "clean": "rimraf dist",
        "lint": "biome check . && tsc",
        "lint:fix": "biome check --write",
        "test": "vitest run",
        "test:ci": "vitest run --coverage",
        "prepublishOnly": "pnpm run build",
        "package-version": "echo $npm_package_version",
        "postversion": "biome check --write package.json"
    },
    "dependencies": {
        "@pyroscope/nodejs": "0.6.3",
        "fastify-plugin": "^6.0.0"
    },
    "peerDependencies": {
        "@opentelemetry/sdk-trace-base": "^2.0.0",
        "fastify": "^5.0.0"
    },
    "peerDependenciesMeta": {
        "@opentelemetry/sdk-trace-base": {
            "optional": true
        },
        "fastify": {
            "optional": true
        }
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.12",
        "@lokalise/biome-config": "workspace:^",
        "@lokalise/node-core": "^14.9.1",
        "@lokalise/tsconfig": "workspace:^",
        "@opentelemetry/api": "1.9.1",
        "@opentelemetry/sdk-trace-base": "^2.11.0",
        "@types/node": "^26.4.1",
        "@vitest/coverage-v8": "^4.1.11",
        "fastify": "^5.12.1",
        "pino": "^10.3.1",
        "rimraf": "^6.1.3",
        "typescript": "7.0.2",
        "vitest": "^4.1.11"
    }
}
